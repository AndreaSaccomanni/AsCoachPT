@inject IJSRuntime JS

@*
    Sezione servizi della home.
    I contenuti sono editoriali (non provengono dal database): sono definiti in SchedeServizi.
    Su desktop i dettagli si aprono sotto le card, su mobile in una finestra modale.
*@
<div class="container-fluid pt-4 mt-5 px-4" id="servizi">
    <h2 class="text-center my-2 fs-1 fw-bold">I miei servizi</h2>

    <div class="row justify-content-center">
        @foreach (var servizio in SchedeServizi)
        {
            <div class="col-lg-3 col-md-6 col-12 mt-4 mt-md-4 mb-md-4 d-flex card-wrapper">
                <div class="card fixedCard flex-grow-1">
                    <img class="card-img-top"
                         src="@servizio.ImmagineSrc"
                         srcset="@servizio.ImmagineSrcset"
                         sizes="(max-width: 767.98px) 88vw, (max-width: 991.98px) 45vw, 300px"
                         width="@servizio.ImmagineLarghezza"
                         height="@servizio.ImmagineAltezza"
                         alt="@servizio.Titolo"
                         loading="lazy"
                         decoding="async" />
                    <div class="overlay"></div>
                    <div class="card-body">
                        <h5 class="card-title text-center">@servizio.Titolo</h5>
                        <p class="card-text text-center">@servizio.Descrizione</p>
                        <button type="button"
                                class="btn btn-link d-block mx-auto mt-2 text-decoration-none link-arancione"
                                aria-expanded="@(aperto?.Id == servizio.Id)"
                                aria-controls="dettagli-servizio-@servizio.Id"
                                @onclick="() => Apri(servizio)">
                            @(aperto?.Id == servizio.Id ? "Nascondi dettagli" : "Scopri di più")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!mobile)
    {
        <div class="row mt-5">
            <div class="col">
                @if (aperto is not null)
                {
                    <div class="dettagli-container" id="dettagli-servizio-@aperto.Id">
                        <h3 class="text-center mt-4">@aperto.Titolo</h3>
                        <ul class="text-muted text-center list-unstyled">
                            @foreach (var dettaglio in aperto.Dettagli)
                            {
                                <li class="mb-2">@((MarkupString)Grassetto(dettaglio))</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    }

    @if (mobile && modaleAperta && aperto is not null)
    {
        <div class="modal d-block modal-servizi" style="background: rgba(0,0,0,.6);"
             role="dialog" aria-modal="true" aria-labelledby="titolo-modale-servizio"
             tabindex="-1" @onclick="ChiudiModale" @onkeydown="OnKeyDown">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" @onclick:stopPropagation="true">
                <div class="modal-content" style="background-color: #1a1a1a; color: white;">
                    <div class="modal-header border-0">
                        <h5 class="modal-title w-100 text-center" id="titolo-modale-servizio">@aperto.Titolo</h5>
                        <button type="button" class="btn-close btn-close-white" aria-label="Chiudi" @onclick="ChiudiModale"></button>
                    </div>
                    <div class="modal-body">
                        <ul class="list-unstyled">
                            @foreach (var dettaglio in aperto.Dettagli)
                            {
                                <li class="mb-3">@((MarkupString)Grassetto(dettaglio))</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool mobile;
    private bool modaleAperta;
    private ServizioCard? aperto;

    /// <summary>
    /// Contenuti editoriali delle card servizi. Restano nel componente perché sono testi
    /// di marketing legati alla home e non dati gestiti dal database.
    /// </summary>
    private static readonly List<ServizioCard> SchedeServizi = new()
    {
        new(1, "Piano di Allenamento Personalizzato", "Pianificazione di un ciclo di allenamenti o aggiornamento della scheda precedente.",
            new[]
