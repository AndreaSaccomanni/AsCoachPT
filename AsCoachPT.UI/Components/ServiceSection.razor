                "**Recupero post-infortunio**: Sedute 1 a 1 per recuperare lo stato di forma pre infortunio in accordo con il tuo fisioterapista",
                "**Gestione delle problematiche**: Trattamento di problemi articolari o muscolari tramite il movimento",
                "**Applicazione tape kinesiologico**: Favorisce il drenaggio linfatico e riduce il gonfiore a seguito di traumi o infiammazioni.",
                "**Adatto a varie esigenze**: Utile in ambito sportivo, posturale o riabilitativo, per adulti e bambini."
            },
            "assets/images/taping-500.webp",
            "assets/images/taping-300.webp 300w, assets/images/taping-500.webp 500w",
            500, 304)
    };

    /// <summary>
    /// Determina una sola volta se il layout è mobile, per scegliere tra dettagli inline
    /// (desktop) e finestra modale (telefono). La larghezza è letta via JS, senza eval.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            mobile = await JS.InvokeAsync<bool>("asCoachIsMobile");
        }
        catch (JSException)
        {
            // Se il JS non è disponibile (es. prerender) resta il layout desktop, che è sempre leggibile.
            mobile = false;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Apre o chiude i dettagli del servizio: modale su mobile, pannello inline su desktop.
    /// Un secondo clic sullo stesso servizio chiude il pannello.
    /// </summary>
    private void Apri(ServizioCard servizio)
    {
        if (mobile)
        {
            aperto = servizio;
            modaleAperta = true;
            return;
        }

        aperto = aperto?.Id == servizio.Id ? null : servizio;
    }

    /// <summary>Chiude la modale mobile e azzera il servizio selezionato.</summary>
    private void ChiudiModale()
    {
        modaleAperta = false;
        aperto = null;
    }

    /// <summary>Gestisce il tasto Escape per chiudere la modale come una finestra nativa.</summary>
    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            ChiudiModale();
        }
    }

    /// <summary>
    /// Converte la sintassi **testo** in grassetto. Il testo viene prima codificato in HTML,
    /// così non è possibile iniettare markup: solo il grassetto aggiunto qui viene interpretato.
    /// </summary>
    private static string Grassetto(string testo) =>
        System.Text.RegularExpressions.Regex.Replace(
            System.Net.WebUtility.HtmlEncode(testo),
            "\\*\\*(.*?)\\*\\*",
            "<strong>$1</strong>");

    /// <summary>Modello di una card servizio della home.</summary>
    /// <summary>
    /// Card servizio con immagine ottimizzata: src principale, srcset per le diverse densità
    /// e dimensioni intrinseche, così il browser riserva lo spazio ed evita layout shift.
    /// </summary>
    public record ServizioCard(
        int Id,
        string Titolo,
        string Descrizione,
        string[] Dettagli,
        string ImmagineSrc,
        string ImmagineSrcset,
        int ImmagineLarghezza,
        int ImmagineAltezza);
}
