@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    Sezione servizi della home.
    I contenuti sono editoriali (non provengono dal database): sono definiti in SchedeServizi.
    Con DettagliInModale i dettagli si aprono in un dialogo sopra la pagina (home); altrimenti
    su desktop si aprono nel pannello sotto le card (pagina Servizi).
*@
<div class="container-fluid pt-4 mt-5 px-4" id="servizi">
    <div class="section-head">
        <p class="section-eyebrow">Servizi</p>
        <h2 class="section-title">I miei servizi</h2>
        <p class="section-sub">Percorsi di allenamento, massaggio e recupero costruiti sulle tue esigenze.</p>
    </div>

    <div class="row g-4 justify-content-center">
        @foreach (var servizio in SchedeServizi)
        {
            <div class="col-lg-3 col-md-6 col-12 d-flex card-wrapper">
                <article class="card fixedCard flex-grow-1">
                    <img class="card-img-top"
                         src="@servizio.ImmagineSrc"
                         srcset="@servizio.ImmagineSrcset"
                         sizes="(max-width: 767.98px) 88vw, (max-width: 991.98px) 45vw, 300px"
                         width="@servizio.ImmagineLarghezza"
                         height="@servizio.ImmagineAltezza"
                         alt="@servizio.Titolo"
                         loading="lazy"
                         decoding="async" />
                    <div class="card-body">
                        <h5 class="card-title">@servizio.Titolo</h5>
                        <p class="card-text">@servizio.Descrizione</p>
                        <button type="button"
                                class="btn btn-servizio mt-auto"
                                aria-haspopup="@(DettagliInModale ? "dialog" : null)"
                                aria-expanded="@(aperto?.Id == servizio.Id ? "true" : "false")"
                                aria-controls="dettagli-servizio-@servizio.Id"
                                @onclick="() => Apri(servizio)">
                            @(aperto?.Id == servizio.Id ? "Nascondi dettagli" : "Scopri di più")
                            <i class="fas @(aperto?.Id == servizio.Id ? "fa-chevron-up" : "fa-arrow-right")" aria-hidden="true"></i>
                        </button>
                    </div>
                </article>
            </div>
        }
    </div>

    @if (!mobile && !DettagliInModale)
    {
        <div class="row mt-5">
            <div class="col">
                @if (aperto is not null)
                {
                    <div class="dettagli-container" id="dettagli-servizio-@aperto.Id">
                        <h3 class="text-center mt-4">@aperto.Titolo</h3>
                        <ul class="text-muted list-unstyled">
                            @foreach (var dettaglio in aperto.Dettagli)
                            {
                                <li class="mb-2">@((MarkupString)Grassetto(dettaglio))</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    }

    @if (modaleAperta && aperto is not null)
    {
        <div class="modal-servizio" role="presentation" @onclick="ChiudiModale">
            <div class="modal-servizio-panel"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="titolo-modale-servizio"
                 tabindex="-1"
                 @ref="pannello"
                 @onclick:stopPropagation="true"
                 @onkeydown="OnKeyDown">
                <div class="modal-servizio-head">
                    <div>
                        <p class="section-eyebrow mb-1">Servizio</p>
                        <h5 id="titolo-modale-servizio">@aperto.Titolo</h5>
                    </div>
                    <button type="button" class="modal-servizio-close" aria-label="Chiudi i dettagli" @onclick="ChiudiModale">
                        <i class="fas fa-xmark" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="modal-servizio-body">
                    <ul class="list-unstyled mb-0">
                        @foreach (var dettaglio in aperto.Dettagli)
                        {
                            <li>@((MarkupString)Grassetto(dettaglio))</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Apre i dettagli in un dialogo sopra la pagina invece che nel pannello sotto le card.
    /// Usato dalla home, dove il pannello costringerebbe a scorrere.
    /// </summary>
    [Parameter]
    public bool DettagliInModale { get; set; }

    private bool mobile;
    private bool modaleAperta;
    private bool daFocalizzare;
    private ElementReference pannello;
    private ServizioCard? aperto;

    /// <summary>
    /// Contenuti editoriali delle card servizi. Restano nel componente perché sono testi
    /// di marketing legati alla home e non dati gestiti dal database.
    /// </summary>
    private static readonly List<ServizioCard> SchedeServizi = new()
    {
        new(1, "Piano di Allenamento Personalizzato", "Pianificazione di un ciclo di allenamenti o aggiornamento della scheda precedente.",
            new[]
            {
                "**Valutazione iniziale**: Durante il primo incontro analizziamo il livello di allenamento, il punto di partenza e tracciamo la direzione da intraprendere.",
                "**Programmazione**: Struttura del piano di allenamento su 8 settimane, personalizzato per durata, tipologia e impegni quotidiani.",
                "**Supporto continuo**: Comunicazione costante ed eventuale follow-up per aggiustamenti durante il percorso.",
                "**Check up finale**: Valutazione alla fine del percorso ed eventuale pianificazione del proseguimento."
            },
            "assets/images/consulenza-800.webp",
            "assets/images/consulenza-400.webp 400w, assets/images/consulenza-800.webp 800w",
            800, 600),
        new(2, "Massaggi", "Massaggio rilassante per alleviare lo stress.",
            new[]
            {
                "**Massaggio rilassante**: Prenditi cura di te e goditi un massaggio completo per ridurre lo stress e le tensioni emotive. 30 min | 1h",
                "**Massaggio sportivo**: Tecniche manuali per favorire il recupero post esercizio o sciogliere contratture muscolari. 30 min | 1h"
            },
            "assets/images/rilassante-800.webp",
            "assets/images/rilassante-400.webp 400w, assets/images/rilassante-800.webp 800w",
            800, 600),
        new(3, "Personal Training", "Allenamento 1 a 1",
            new[]
            {
                "**Seduta di allenamento 1 a 1.**: Tecniche specifiche migliorano la flessibilità e riducono il rischio di lesioni muscolari.",
                "**Allenamento individuale per calciatori - tecnica individuale - Ball Mastery (min.10 anni)**: ",
                "**Allenamento per bambini 8+**:",
                "**Allenamento cognitivo per anziani**: "
            },
            "assets/images/decontratturante-800.webp",
            "assets/images/decontratturante-400.webp 400w, assets/images/decontratturante-800.webp 800w",
            800, 600),
        new(4, "Trattamento infortuni", "Percorso personalizzato per il recupero da infortuni, mirato a ripristinare mobilità, forza e funzionalità in sicurezza.",
            new[]
            {
                "**Recupero post-infortunio**: Sedute 1 a 1 per recuperare lo stato di forma pre infortunio in accordo con il tuo fisioterapista",
                "**Gestione delle problematiche**: Trattamento di problemi articolari o muscolari tramite il movimento",
                "**Applicazione tape kinesiologico**: Favorisce il drenaggio linfatico e riduce il gonfiore a seguito di traumi o infiammazioni.",
                "**Adatto a varie esigenze**: Utile in ambito sportivo, posturale o riabilitativo, per adulti e bambini."
            },
            "assets/images/taping-500.webp",
            "assets/images/taping-300.webp 300w, assets/images/taping-500.webp 500w",
            500, 304)
    };

    /// <summary>
    /// Determina una sola volta se il layout è mobile (per il pannello inline della pagina
    /// Servizi) e porta il focus sul dialogo appena viene aperto.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                mobile = await JS.InvokeAsync<bool>("asCoachIsMobile");
            }
            catch (JSException)
            {
                // Se il JS non è disponibile (es. prerender) resta il layout desktop, che è sempre leggibile.
                mobile = false;
            }

            StateHasChanged();
        }

        if (modaleAperta && daFocalizzare)
        {
            daFocalizzare = false;

            try
            {
                await pannello.FocusAsync(preventScroll: true);
            }
            catch (JSException)
            {
                // Focus non disponibile (prerender): Escape funziona comunque sul body.
            }
        }
    }

    /// <summary>
    /// Apre i dettagli del servizio: dialogo quando richiesto (home) o su telefono,
    /// pannello inline sulla pagina Servizi. Un secondo clic sullo stesso servizio
    /// chiude il pannello inline.
    /// </summary>
    private async Task Apri(ServizioCard servizio)
    {
        if (mobile || DettagliInModale)
        {
            aperto = servizio;
            modaleAperta = true;
            daFocalizzare = true;
            await BloccaScorrimentoAsync(true);
            return;
        }

        aperto = aperto?.Id == servizio.Id ? null : servizio;
    }

    /// <summary>Chiude il dialogo e ripristina scroll e focus della pagina.</summary>
    private async Task ChiudiModale()
    {
        if (!modaleAperta)
        {
            return;
        }

        modaleAperta = false;
        aperto = null;
        await BloccaScorrimentoAsync(false);
    }

    /// <summary>Gestisce il tasto Escape per chiudere il dialogo come una finestra nativa.</summary>
    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await ChiudiModale();
        }
    }

    /// <summary>
    /// Blocca lo scroll della pagina mentre il dialogo è aperto e, alla chiusura,
    /// riporta il focus sull'elemento che aveva aperto i dettagli.
    /// </summary>
    private async Task BloccaScorrimentoAsync(bool apri)
    {
        try
        {
            await JS.InvokeVoidAsync("asCoachModal", apri);
        }
        catch (JSException)
        {
            // Prerender o interop non disponibile: il dialogo resta usabile comunque.
        }
    }

    /// <summary>Rilascia lo scroll se l'utente lascia la pagina con il dialogo aperto.</summary>
    public async ValueTask DisposeAsync()
    {
        if (!modaleAperta)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("asCoachModal", false);
        }
        catch (Exception)
        {
            // Circuito già chiuso: non c'è nulla da ripristinare.
        }
    }

    /// <summary>
    /// Converte la sintassi **testo** in grassetto. Il testo viene prima codificato in HTML,
    /// così non è possibile iniettare markup: solo il grassetto aggiunto qui viene interpretato.
    /// </summary>
    private static string Grassetto(string testo) =>
        System.Text.RegularExpressions.Regex.Replace(
            System.Net.WebUtility.HtmlEncode(testo),
            "\\*\\*(.*?)\\*\\*",
            "<strong>$1</strong>");

    /// <summary>Modello di una card servizio della home.</summary>
    /// <summary>
    /// Card servizio con immagine ottimizzata: src principale, srcset per le diverse densità
    /// e dimensioni intrinseche, così il browser riserva lo spazio ed evita layout shift.
    /// </summary>
    public record ServizioCard(
        int Id,
        string Titolo,
        string Descrizione,
        string[] Dettagli,
        string ImmagineSrc,
        string ImmagineSrcset,
        int ImmagineLarghezza,
        int ImmagineAltezza);
}
