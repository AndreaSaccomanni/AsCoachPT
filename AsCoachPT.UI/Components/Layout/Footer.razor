@inject NavigationManager NavigationManager

<footer class="footer-gradient @(IsHome ? "footer-home" : "footer-servizi") text-white py-4">
    <div class="container">
        <div class="row g-4 text-center text-md-start">
            <div class="col-md-5">
                <h5 class="footer-title">Contatti</h5>
                <div class="footer-row">
                    <i class="fas fa-envelope contact-icon" aria-hidden="true"></i>
                    <a href="mailto:saccales@hotmail.com" class="footer-link">saccales@hotmail.com</a>
                </div>
                <div class="footer-row">
                    <i class="fas fa-phone contact-icon" aria-hidden="true"></i>
                    <a href="tel:+393772082714" class="footer-link">+39 377 208 2714</a>
                </div>
                <div class="footer-row">
                    <i class="fas fa-location-dot contact-icon" aria-hidden="true"></i>
                    <a href="https://www.google.it/maps/place/Via+Madonna+del+Prato,+5,+05023+Civitella+del+Lago+TR/@@42.70992,12.2821916,17z"
                       class="footer-link" target="_blank" rel="noopener noreferrer">
                        Via Madonna del Prato 5, Civitella del Lago (TR)
                    </a>
                </div>
            </div>

            <div class="col-md-4 d-none d-md-block">
                <h5 class="footer-title">Link utili</h5>
                <ul class="footer-links">
                    <li><a href="/chiSono" class="footer-link">Chi Sono</a></li>
                    <li><a href="/servizi" class="footer-link">Servizi</a></li>
                    <li><a href="/indirizzo" class="footer-link">Indirizzi</a></li>
                </ul>
            </div>

            <div class="col-md-3">
                <h5 class="footer-title">Seguimi</h5>
                <div class="footer-socials">
                    <a href="https://www.instagram.com/_as_coach/" target="_blank" rel="noopener noreferrer" class="footer-social" aria-label="Instagram">
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" class="footer-social" aria-label="Facebook">
                        <i class="fab fa-facebook"></i>
                    </a>
                </div>
            </div>
        </div>

        <hr class="footer-divider" />
        <div class="text-center footer-copy">
            <small>© @DateTime.Now.Year Alessandro Saccomanni - Personal Trainer</small>
        </div>
    </div>
</footer>

@code {
    private bool IsHome => new Uri(NavigationManager.Uri).AbsolutePath is "/" or "";
}
