@page "/cambia-password"
@attribute [Authorize]
@inject PasswordResetService ResetSvc
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<div class="container mt-5">
    <div class="row justify-content-md-center">
        <div class="col-md-6 auth-panel">
            <h2 class="text-center">Cambia password</h2>
            <p class="text-muted">Inserisci la password attuale e scegli quella nuova (almeno 8 caratteri).</p>

            @if (!string.IsNullOrWhiteSpace(errore))
            {
                <div class="alert alert-danger">@errore</div>
            }

            <MudTextField T="string" Label="Password attuale" @bind-Value="attuale" InputType="InputType.Password"
                          Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField T="string" Label="Nuova password" @bind-Value="nuova" InputType="InputType.Password"
                          Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField T="string" Label="Conferma nuova password" @bind-Value="conferma" InputType="InputType.Password"
                          Variant="Variant.Outlined" Class="mb-3" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvaAsync"
                       Disabled="@(salvando || string.IsNullOrWhiteSpace(attuale) || string.IsNullOrWhiteSpace(nuova))" Class="w-100">
                @(salvando ? "Salvataggio..." : "Aggiorna password")
            </MudButton>

            <div class="text-center mt-3">
                <a href="/" class="footer-link">Torna alla home</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string attuale = string.Empty;
    private string nuova = string.Empty;
    private string conferma = string.Empty;
    private string? errore;
    private bool salvando;

    private async Task SalvaAsync()
    {
        if (salvando)
        {
            return;
        }

        errore = null;

        if (nuova != conferma)
        {
            errore = "Le due nuove password non coincidono.";
            return;
        }

        if (nuova.Length < PasswordResetService.LunghezzaMinimaPassword)
        {
            errore = $"La nuova password deve contenere almeno {PasswordResetService.LunghezzaMinimaPassword} caratteri.";
            return;
        }

        salvando = true;

        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var utente = ClaimsPrincipalFactory.ToAppUser(state.User);

            if (utente is null)
            {
                errore = "Sessione non valida. Effettua di nuovo il login.";
                return;
            }

            await ResetSvc.CambiaPasswordAsync(utente.Id, attuale, nuova);

            // La versione di sicurezza è cambiata: il cookie attuale non è più valido.
            Nav.NavigateTo("/login?passwordChanged=1", forceLoad: true);
        }
        catch (InvalidOperationException eccezione)
        {
            errore = eccezione.Message;
        }
        catch (Exception)
        {
            errore = "Non è stato possibile aggiornare la password. Riprova più tardi.";
        }
        finally
        {
            salvando = false;
        }
    }
}
