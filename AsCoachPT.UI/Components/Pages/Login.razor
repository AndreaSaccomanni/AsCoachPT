@page "/login"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Forms

<div class="container mt-5">
    <div class="row justify-content-md-center">
        <div class="col-md-6 auth-panel">
            <h2 class="text-center">Login</h2>

            @if (Registered == 1)
            {
                <div class="alert alert-success">Registrazione riuscita! Puoi ora effettuare il login.</div>
            }
            @if (Timeout == 1)
            {
                <div class="alert alert-session">La sessione è scaduta dopo 30 minuti. Effettua di nuovo il login.</div>
            }
            @if (Error == 1)
            {
                <div class="alert alert-danger">Errore durante il login: credenziali non valide</div>
            }

            <form method="post" action="/auth/login">
                <div class="mb-3">
                    <label class="form-label" for="username">Username</label>
                    <input class="form-control" id="username" name="username" type="text" placeholder="Inserisci il tuo username" required autocomplete="username" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <input class="form-control" id="password" name="password" type="password" placeholder="Inserisci la password" required autocomplete="current-password" />
                </div>
                <button class="btn btn-primary w-100 mt-3" type="submit">Login</button>
            </form>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public int? Error { get; set; }

    [SupplyParameterFromQuery(Name = "registered")]
    public int? Registered { get; set; }

    [SupplyParameterFromQuery(Name = "timeout")]
    public int? Timeout { get; set; }
}
