@page "/login"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Forms
@inject GoogleLoginSettings GoogleLogin

<div class="container mt-5">
    <div class="row justify-content-md-center">
        <div class="col-md-6 auth-panel">
            <h2 class="text-center">Login</h2>

            @if (Registered == 1)
            {
                <div class="alert alert-success">Registrazione riuscita! Puoi ora effettuare il login.</div>
            }
            @if (Timeout == 1)
            {
                <div class="alert alert-session">La sessione è scaduta dopo 30 minuti. Effettua di nuovo il login.</div>
            }
            @if (Error == 1)
            {
                <div class="alert alert-danger">Errore durante il login: credenziali non valide</div>
            }
            @if (PasswordChanged == 1)
            {
                <div class="alert alert-success">Password aggiornata. Effettua di nuovo il login.</div>
            }
            @if (GoogleError == "unverified")
            {
                <div class="alert alert-danger">L'account Google non ha un'email verificata.</div>
            }
            @if (GoogleError == "nonexistent")
            {
                <div class="alert alert-danger">Non esiste un account AsCoach con questa email. Registrati prima di usare Google.</div>
            }
            @if (GoogleError == "config")
            {
                <div class="alert alert-danger">Login Google non configurato.</div>
            }
            @if (GoogleError == "failed")
            {
                <div class="alert alert-danger">Accesso con Google non riuscito. Riprova.</div>
            }

            <form method="post" action="/auth/login">
                <div class="mb-3 campo-flottante">
                    <input class="form-control" id="email" name="email" type="text" inputmode="email" placeholder=" " required autocomplete="username" />
                    <label class="campo-etichetta" for="email">Email</label>
                </div>
                <div class="mb-3 campo-flottante">
                    <input class="form-control" id="password" name="password" type="password" placeholder=" " required autocomplete="current-password" />
                    <label class="campo-etichetta" for="password">Password</label>
                </div>
                <button class="btn btn-primary w-100 mt-3" type="submit">Login</button>
            </form>

            @if (GoogleLogin.Abilitato)
            {
                <div class="text-center text-muted my-3">oppure</div>
                <a href="/auth/google" class="btn btn-outline-dark w-100">
                    <i class="fab fa-google me-2" aria-hidden="true"></i> Continua con Google
                </a>
            }

            <div class="text-center mt-3">
                <a href="/password-dimenticata" class="footer-link">Password dimenticata?</a>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public int? Error { get; set; }

    [SupplyParameterFromQuery(Name = "registered")]
    public int? Registered { get; set; }

    [SupplyParameterFromQuery(Name = "timeout")]
    public int? Timeout { get; set; }

    [SupplyParameterFromQuery(Name = "passwordChanged")]
    public int? PasswordChanged { get; set; }

    [SupplyParameterFromQuery(Name = "googleError")]
    public string? GoogleError { get; set; }
}
