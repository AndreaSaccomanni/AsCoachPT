@page "/gestioneIndirizzi"
@attribute [Authorize(Roles = "ADMIN,PERSONAL_TRAINER")]
@implements IDisposable
@inject IndirizzoService IndirizziSvc
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="my-8">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <MudText Typo="Typo.h4">Gestione Indirizzi</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddLocationAlt" OnClick="ApriAggiunta">
            Aggiungi Indirizzo
        </MudButton>
    </div>

    @if (!string.IsNullOrWhiteSpace(erroreGiorni))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@erroreGiorni</MudAlert>
    }

    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (indirizzi.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">Nessun indirizzo trovato.</MudAlert>
    }
    else
    {
        <MudTable Items="@Righe" Hover="true" Breakpoint="Breakpoint.Sm" Striped="true" Elevation="2">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>Via</MudTh>
                <MudTh>Civico</MudTh>
                <MudTh>Città</MudTh>
                <MudTh>Provincia</MudTh>
                <MudTh>Nome Studio</MudTh>
                <MudTh>Stato</MudTh>
                <MudTh>Giorni</MudTh>
                <MudTh>Azioni</MudTh>
            </HeaderContent>
            <RowTemplate Context="riga">
                <MudTd DataLabel="#">@riga.Posizione</MudTd>
                <MudTd DataLabel="Via">@riga.Indirizzo.Via</MudTd>
                <MudTd DataLabel="Civico">@riga.Indirizzo.NumeroCivico</MudTd>
                <MudTd DataLabel="Città">@riga.Indirizzo.Citta</MudTd>
                <MudTd DataLabel="Provincia">@riga.Indirizzo.Provincia</MudTd>
                <MudTd DataLabel="Studio">@riga.Indirizzo.NomeStudio</MudTd>
                <MudTd DataLabel="Stato">
                    <span class="stato-studio @(riga.Indirizzo.Attivo ? "attivo" : "disabilitato")">
                        @(riga.Indirizzo.Attivo ? "Attivo" : "Disabilitato")
                    </span>
                </MudTd>
                <MudTd DataLabel="Giorni">@(riga.Indirizzo.Giorni.Count > 0 ? string.Join(" - ", riga.Indirizzo.Giorni) : "Nessun giorno assegnato")</MudTd>
                <MudTd DataLabel="Azioni">
                    <MudButton Variant="Variant.Text"
                               Color="@(riga.Indirizzo.Attivo ? Color.Warning : Color.Success)"
                               StartIcon="@(riga.Indirizzo.Attivo ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                               OnClick="() => CambiaStatoAsync(riga.Indirizzo)">
                        @(riga.Indirizzo.Attivo ? "Disabilita" : "Abilita")
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="() => ApriModifica(riga.Indirizzo)">Modifica</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="() => ChiediEliminazioneAsync(riga.Indirizzo.Id)">Elimina</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudDialog @bind-Visible="modaleAperta" Options="opzioniDialog">
        <TitleContent>
            <MudText Typo="Typo.h6">@(modale.Id is null ? "Aggiungi Indirizzo" : "Modifica Indirizzo")</MudText>
        </TitleContent>
        <DialogContent>
            @if (!string.IsNullOrWhiteSpace(erroreModale))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@erroreModale</MudAlert>
            }

            <div class="dialog-address-grid">
                <div class="dialog-address-form">
                    <div class="place-search">
                        <MudTextField T="string" Label="Cerca luogo (Google)" @bind-Value="modale.Luogo" Immediate="true"
                                      Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                      DebounceInterval="200" OnDebounceIntervalElapsed="CercaSuggerimentiAsync" />

                        @if (caricandoSuggerimenti)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="place-loading" />
                        }
                        else if (suggerimenti.Count > 0)
                        {
                            <div class="place-suggestions" role="listbox" aria-label="Suggerimenti indirizzo">
                                @foreach (var suggerimento in suggerimenti)
                                {
                                    <button type="button" class="place-suggestion" role="option"
                                            @onclick="() => SelezionaSuggerimentoAsync(suggerimento)">
                                        <i class="fas fa-location-dot place-suggestion-icon" aria-hidden="true"></i>
                                        <span class="place-suggestion-text">
                                            <span class="place-suggestion-primary">@suggerimento.PrimaryText</span>
                                            @if (!string.IsNullOrWhiteSpace(suggerimento.SecondaryText))
                                            {
                                                <span class="place-suggestion-secondary">@suggerimento.SecondaryText</span>
                                            }
                                        </span>
                                    </button>
                                }
                                <div class="place-suggestions-footer">Suggerimenti di Google</div>
                            </div>
                        }
                        else if (ricercaEseguita && modale.Luogo.Trim().Length >= 3)
                        {
                            <div class="place-suggestions place-suggestions-empty">
                                Nessun risultato: aggiungi città o provincia e riprova.
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(modale.LuogoTrovato))
                    {
                        <div class="place-selected" role="status">
                            <i class="fas fa-circle-check" aria-hidden="true"></i>
                            <span>@modale.LuogoTrovato</span>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="place-hint d-block mb-3">
                            Scegli un suggerimento oppure clicca direttamente sulla mappa.
                        </MudText>
                    }

                    @if (modale.Id is not null)
                    {
                        <div class="dialog-field-grid">
                            <MudTextField T="string" Label="Via" @bind-Value="modale.Via" Variant="Variant.Outlined" Class="mb-4" />
                            <MudTextField T="string" Label="Numero civico" @bind-Value="modale.NumeroCivico" Variant="Variant.Outlined" Class="mb-4" />
                            <MudTextField T="string" Label="Città" @bind-Value="modale.Citta" Variant="Variant.Outlined" Class="mb-4" />
                            <MudTextField T="string" Label="Provincia" @bind-Value="modale.Provincia" Variant="Variant.Outlined" Class="mb-4" />
                        </div>
                    }

                    <MudTextField T="string" Label="Nome Studio" @bind-Value="modale.NomeStudio" Variant="Variant.Outlined" Class="mb-4" Required="true" />

                    <MudText Typo="Typo.subtitle2" Class="mb-2">Giorni disponibili</MudText>
                    @if (!modale.Attivo)
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-2">
                            Studio disabilitato: i giorni sono liberi. Riabilitalo dalla lista per riassegnarli.
                        </MudAlert>
                    }
                    <div class="dialog-days">
                        @foreach (var giorno in GiorniSettimana)
                        {
                            var assegnatoAltrove = giorniAssegnati.Contains(giorno) && !modale.Giorni.Contains(giorno);
                            <MudCheckBox T="bool" Value="@modale.Giorni.Contains(giorno)" Label="@giorno"
                                         Disabled="@(!modale.Attivo || assegnatoAltrove)"
                                         ValueChanged="@((bool v) => ToggleGiorno(giorno, v))" Color="Color.Primary" />
                        }
                    </div>
                </div>

                <div class="dialog-address-map">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Posizione sulla mappa</MudText>
                    <div id="selettore-mappa" class="map-picker" aria-label="Mappa per scegliere l'indirizzo"></div>
                    <MudText Typo="Typo.caption" Class="d-block">
                        Clicca sulla mappa per impostare l'indirizzo dello studio.
                    </MudText>

                    @if (mappaSelettoreFallita)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Refresh" OnClick="RiprovaMappaAsync" Class="mt-3">
                            Riprova a caricare la mappa
                        </MudButton>
                    }
                </div>
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="ChiudiModaleAsync">Chiudi</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SalvaAsync" Disabled="salvando">
                @(modale.Id is null ? "Aggiungi" : "Salva Modifiche")
            </MudButton>
        </DialogActions>
    </MudDialog>

    <MudDialog @bind-Visible="confermaAperta">
        <TitleContent><MudText Typo="Typo.h6">Elimina indirizzo</MudText></TitleContent>
        <DialogContent>
            <MudText>@testoConferma</MudText>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => confermaAperta = false">Annulla</MudButton>
            <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="EliminaConfermataAsync">Elimina</MudButton>
        </DialogActions>
    </MudDialog>
</MudContainer>

@code {
    private record Riga(int Posizione, Indirizzo Indirizzo);

    private static readonly string[] GiorniSettimana = { "LUNEDI", "MARTEDI", "MERCOLEDI", "GIOVEDI", "VENERDI", "SABATO" };

    private List<Indirizzo> indirizzi = new();
    private List<Riga> Righe = new();
    private List<string> giorniAssegnati = new();
    private IndirizzoModale modale = new();
    private string? erroreModale;
    private string? erroreGiorni;
    private string testoConferma = string.Empty;
    private bool loading = true;
    private bool salvando;
    private bool modaleAperta;
    private bool confermaAperta;
    private long idDaEliminare;
    private string? luogoRisolto;
    private List<SuggerimentoLuogo> suggerimenti = new();
    private bool caricandoSuggerimenti;
    private int versioneRicerca;
    private bool mappaSelettoreInizializzata;
    private bool mappaSelettoreFallita;
    private bool ricercaEseguita;
    private DotNetObjectReference<GestioneIndirizzi>? riferimentoJs;

    private const string IdSelettoreMappa = "selettore-mappa";
    private const string MessaggioMappaNonDisponibile = "Mappa non disponibile: controlla la connessione a Google Maps.";

    private readonly DialogOptions opzioniDialog = new()
    {
        FullWidth = true,
        MaxWidth = MaxWidth.Large
    };

    protected override async Task OnInitializedAsync()
    {
        riferimentoJs = DotNetObjectReference.Create(this);
        await CaricaAsync();
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (modaleAperta && !mappaSelettoreInizializzata && !mappaSelettoreFallita)
        {
            mappaSelettoreInizializzata = await JS.InvokeAsync<bool>(
                "asCoachInitMapPicker", IdSelettoreMappa, riferimentoJs, modale.Latitudine, modale.Longitudine);

            if (!mappaSelettoreInizializzata)
            {
                mappaSelettoreFallita = true;
                erroreModale = MessaggioMappaNonDisponibile;
                StateHasChanged();
            }
            else
            {
                mappaSelettoreFallita = false;
                if (erroreModale == MessaggioMappaNonDisponibile)
                {
                    erroreModale = null;
                }
            }
        }
        else if (!modaleAperta && mappaSelettoreInizializzata)
        {
            await JS.InvokeVoidAsync("asCoachDisposeMapPicker", IdSelettoreMappa);
            mappaSelettoreInizializzata = false;
        }
    }

    private async Task CaricaAsync()
    {
        indirizzi = await IndirizziSvc.ElencaAsync(includiDisabilitati: true);
        giorniAssegnati = indirizzi.Where(i => i.Attivo).SelectMany(i => i.Giorni).ToList();
        Righe = indirizzi.Select((i, idx) => new Riga(idx + 1, i)).ToList();
    }

    /// <summary>Abilita o disabilita lo studio: disabilitandolo i giorni tornano liberi.</summary>
    private async Task CambiaStatoAsync(Indirizzo indirizzo)
    {
        var disabilitato = indirizzo.Attivo;

        try
        {
            await IndirizziSvc.ImpostaAttivoAsync(indirizzo.Id, !indirizzo.Attivo);
            await CaricaAsync();
            Snackbar.Add(
                disabilitato
                    ? "Indirizzo disabilitato: i giorni sono di nuovo disponibili per un altro studio."
                    : "Indirizzo riabilitato: assegna nuovamente i giorni di ricevimento.",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void ApriAggiunta()
    {
        if (giorniAssegnati.Count == 6)
        {
            erroreGiorni = "Non ci sono giorni liberi. Prima di aggiungere un nuovo indirizzo, rimuovi un giorno da uno degli indirizzi esistenti.";
            return;
        }

        erroreGiorni = null;
        erroreModale = null;
        modale = new IndirizzoModale();
        luogoRisolto = null;
        suggerimenti = new();
        caricandoSuggerimenti = false;
        versioneRicerca++;
        mappaSelettoreInizializzata = false;
        mappaSelettoreFallita = false;
        ricercaEseguita = false;
        modaleAperta = true;
    }

    private void ApriModifica(Indirizzo indirizzo)
    {
        erroreModale = null;
        luogoRisolto = null;
        suggerimenti = new();
        caricandoSuggerimenti = false;
        versioneRicerca++;
        mappaSelettoreInizializzata = false;
        mappaSelettoreFallita = false;
        ricercaEseguita = false;
        modale = new IndirizzoModale
        {
            Id = indirizzo.Id,
            Attivo = indirizzo.Attivo,
            Via = indirizzo.Via,
            NumeroCivico = indirizzo.NumeroCivico,
            Citta = indirizzo.Citta,
            Provincia = indirizzo.Provincia,
            NomeStudio = indirizzo.NomeStudio,
            Latitudine = indirizzo.Latitudine,
            Longitudine = indirizzo.Longitudine,
            Giorni = new List<string>(indirizzo.Giorni)
        };
        modaleAperta = true;
    }

    private void ToggleGiorno(string giorno, bool selezionato)
    {
        if (selezionato && !modale.Giorni.Contains(giorno))
        {
            modale.Giorni.Add(giorno);
        }
        else if (!selezionato)
        {
            modale.Giorni.Remove(giorno);
        }
    }

    /// <summary>Mostra i suggerimenti Google mentre l'utente digita; nessuna scelta automatica.</summary>
    private async Task CercaSuggerimentiAsync(string query)
    {
        var versione = ++versioneRicerca;

        if (string.IsNullOrWhiteSpace(query) || query.Trim().Length < 3 ||
            (!string.IsNullOrWhiteSpace(luogoRisolto) && string.Equals(query, luogoRisolto, StringComparison.Ordinal)))
        {
            suggerimenti = new();
            caricandoSuggerimenti = false;
            ricercaEseguita = false;
            return;
        }

        // Per un nuovo indirizzo, cambiare testo invalida la scelta precedente:
        // solo un suggerimento o un punto sulla mappa forniscono la posizione.
        if (modale.Id is null && !string.IsNullOrWhiteSpace(luogoRisolto))
        {
            modale.LuogoTrovato = string.Empty;
            modale.Latitudine = null;
            modale.Longitudine = null;
            luogoRisolto = null;
        }

        caricandoSuggerimenti = true;
        ricercaEseguita = false;

        try
        {
            var risultati = await JS.InvokeAsync<List<SuggerimentoLuogo>>("asCoachPlaceSuggestions", query);
            if (versione != versioneRicerca)
            {
                return;
            }

            suggerimenti = risultati ?? new();
            ricercaEseguita = true;
        }
        catch (Exception ex)
        {
            if (versione == versioneRicerca)
            {
                erroreModale = "Ricerca luogo non disponibile: " + ex.Message;
                suggerimenti = new();
                ricercaEseguita = false;
            }
        }
        finally
        {
            if (versione == versioneRicerca)
            {
                caricandoSuggerimenti = false;
            }
        }
    }

    private async Task SelezionaSuggerimentoAsync(SuggerimentoLuogo suggerimento)
    {
        try
        {
            var risultato = await JS.InvokeAsync<PlaceResult?>("asCoachPlaceDetails", suggerimento.PlaceId);
            if (risultato is null)
            {
                erroreModale = "Dettaglio del luogo non disponibile: riprova o scegli un altro suggerimento.";
                return;
            }

            ApplicaRisultato(risultato);
            modale.Luogo = risultato.FormattedAddress ?? suggerimento.PrimaryText;
            luogoRisolto = modale.Luogo;
            suggerimenti = new();
            ricercaEseguita = false;
            erroreModale = null;

            if (mappaSelettoreInizializzata && risultato.Lat is double lat && risultato.Lng is double lng)
            {
                await JS.InvokeVoidAsync("asCoachSetMapPickerPosition", IdSelettoreMappa, lat, lng);
            }
        }
        catch (Exception ex)
        {
            erroreModale = "Dettaglio del luogo non disponibile: " + ex.Message;
        }
    }

    private void RiprovaMappaAsync()
    {
        mappaSelettoreFallita = false;
        mappaSelettoreInizializzata = false;
        erroreModale = null;
    }

    /// <summary>Riceve l'indirizzo del punto scelto sulla mappa.</summary>
    [JSInvokable]
    public Task AggiornaDaMappa(PlaceResult risultato)
    {
        if (risultato is null)
        {
            return Task.CompletedTask;
        }

        ApplicaRisultato(risultato);
        modale.Luogo = risultato.FormattedAddress ?? modale.Luogo;
        luogoRisolto = modale.Luogo;
        suggerimenti = new();
        ricercaEseguita = false;
        erroreModale = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ApplicaRisultato(PlaceResult risultato)
    {
        modale.LuogoTrovato = risultato.FormattedAddress ?? string.Empty;
        modale.Via = string.IsNullOrWhiteSpace(risultato.Via)
            ? PrimoSegmento(risultato.FormattedAddress)
            : risultato.Via;
        modale.NumeroCivico = risultato.NumeroCivico ?? string.Empty;
        modale.Citta = risultato.Citta ?? string.Empty;
        modale.Provincia = risultato.Provincia ?? string.Empty;
        if (risultato.Lat is double lat) modale.Latitudine = lat;
        if (risultato.Lng is double lng) modale.Longitudine = lng;
    }

    /// <summary>Usa la prima parte dell'indirizzo quando Google non fornisce la via.</summary>
    private static string PrimoSegmento(string? indirizzo)
    {
        if (string.IsNullOrWhiteSpace(indirizzo))
        {
            return string.Empty;
        }

        var virgola = indirizzo.IndexOf(',');
        return (virgola > 0 ? indirizzo[..virgola] : indirizzo).Trim();
    }

    private async Task ChiudiModaleAsync()
    {
        modaleAperta = false;
        suggerimenti = new();
        caricandoSuggerimenti = false;
        versioneRicerca++;
        ricercaEseguita = false;
        mappaSelettoreFallita = false;

        if (mappaSelettoreInizializzata)
        {
            await JS.InvokeVoidAsync("asCoachDisposeMapPicker", IdSelettoreMappa);
            mappaSelettoreInizializzata = false;
        }
    }

    public void Dispose() => riferimentoJs?.Dispose();

    private async Task SalvaAsync()
    {
        if (string.IsNullOrWhiteSpace(modale.NomeStudio))
        {
            erroreModale = "Il nome studio è obbligatorio";
            return;
        }

        if (modale.Id is null &&
            (modale.Latitudine is null || modale.Longitudine is null || string.IsNullOrWhiteSpace(modale.LuogoTrovato)))
        {
            erroreModale = "Seleziona uno dei suggerimenti Google o un punto sulla mappa: la posizione serve per mostrare la mappa.";
            return;
        }

        salvando = true;
        erroreModale = null;
        try
        {
            var indirizzo = new Indirizzo
            {
                Via = modale.Via,
                NumeroCivico = modale.NumeroCivico,
                Citta = modale.Citta,
                Provincia = modale.Provincia,
                NomeStudio = modale.NomeStudio,
                Latitudine = modale.Latitudine,
                Longitudine = modale.Longitudine,
                GiorniDisponibili = string.Join(", ", modale.Giorni)
            };

            if (modale.Id is null)
            {
                await IndirizziSvc.AggiungiAsync(indirizzo);
            }
            else
            {
                await IndirizziSvc.AggiornaAsync(modale.Id.Value, indirizzo);
            }

            await ChiudiModaleAsync();
            await CaricaAsync();
            Snackbar.Add(modale.Id is null ? "Indirizzo aggiunto" : "Indirizzo aggiornato", Severity.Success);
        }
        catch (Exception ex)
        {
            erroreModale = ex.Message;
        }
        finally
        {
            salvando = false;
        }
    }

    private async Task ChiediEliminazioneAsync(long id)
    {
        idDaEliminare = id;
        var prenotazioni = await IndirizziSvc.ElencaPrenotazioniAsync(id);
        testoConferma = prenotazioni.Count > 0
            ? "Ci sono prenotazioni per quell'indirizzo. Eliminare comunque? Tutte le prenotazioni andranno perse."
            : "Sei sicuro di voler eliminare questo indirizzo?";
        confermaAperta = true;
    }

    private async Task EliminaConfermataAsync()
    {
        try
        {
            await IndirizziSvc.EliminaAsync(idDaEliminare);
            await CaricaAsync();
            Snackbar.Add("Indirizzo eliminato", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private sealed class IndirizzoModale
    {
        public long? Id { get; set; }
        public bool Attivo { get; set; } = true;
        public string Luogo { get; set; } = string.Empty;
        public string LuogoTrovato { get; set; } = string.Empty;
        public string Via { get; set; } = string.Empty;
        public string NumeroCivico { get; set; } = string.Empty;
        public string Citta { get; set; } = string.Empty;
        public string Provincia { get; set; } = string.Empty;
        public string NomeStudio { get; set; } = string.Empty;
        public double? Latitudine { get; set; }
        public double? Longitudine { get; set; }
        public List<string> Giorni { get; set; } = new();
    }

    public sealed class SuggerimentoLuogo
    {
        public string PlaceId { get; set; } = string.Empty;
        public string PrimaryText { get; set; } = string.Empty;
        public string SecondaryText { get; set; } = string.Empty;
    }

    public sealed class PlaceResult
    {
        public string? FormattedAddress { get; set; }
        public string? Via { get; set; }
        public string? NumeroCivico { get; set; }
        public string? Citta { get; set; }
        public string? Provincia { get; set; }
        public double? Lat { get; set; }
        public double? Lng { get; set; }
    }
}
