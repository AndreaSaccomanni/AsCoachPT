@page "/indirizzo"
@inject IndirizzoService IndirizziSvc
@inject AuthenticationStateProvider AuthState

<MudContainer MaxWidth="MaxWidth.Large" Class="my-8">
    <div class="text-center">
        <MudText Typo="Typo.h4" Color="Color.Primary">Tutti gli Indirizzi</MudText>
        <MudText Typo="Typo.h6" Class="mb-6">
            Qui puoi trovare tutti gli indirizzi e gli studi in cui lavoro, con le relative indicazioni stradali
        </MudText>
    </div>

    @if (isStaff)
    {
        <div class="text-start mb-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/gestioneIndirizzi">Gestisci Indirizzi</MudButton>
        </div>
    }

    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (indirizzi.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">Nessun indirizzo trovato.</MudAlert>
    }
    else
    {
        <div class="address-grid">
            @foreach (var indirizzo in indirizzi)
            {
                <article class="address-card">
                    <div class="address-details">
                        <p class="address-eyebrow">@indirizzo.NomeStudio</p>
                        <h3>@indirizzo.Via @indirizzo.NumeroCivico</h3>
                        <p>@indirizzo.Citta (@indirizzo.Provincia)</p>
                        <p class="address-days">
                            @(indirizzo.Giorni.Count > 0
                                ? "Ricevo: " + string.Join(", ", indirizzo.Giorni)
                                : "Nessun giorno assegnato")
                        </p>
                        <div class="address-actions">
                            <a class="address-link" href="@LinkEsterno(indirizzo)" target="_blank" rel="noopener noreferrer">
                                Apri in Google Maps <span aria-hidden="true">↗</span>
                            </a>
                        </div>
                    </div>

                    @if (mappeCaricate.Contains(indirizzo.Id))
                    {
                        <iframe class="address-map" loading="lazy" allowfullscreen
                                referrerpolicy="no-referrer-when-downgrade"
                                src="@LinkMappa(indirizzo)"
                                title="Mappa di @indirizzo.NomeStudio, @indirizzo.Via @indirizzo.NumeroCivico, @indirizzo.Citta"></iframe>
                    }
                    else
                    {
                        <button type="button" class="address-placeholder" @onclick="() => CaricaMappa(indirizzo.Id)">
                            <strong>Mostra la mappa</strong>
                            <span>@indirizzo.NomeStudio · @indirizzo.Citta</span>
                        </button>
                    }
                </article>
            }
        </div>
    }
</MudContainer>

@code {
    private List<Indirizzo> indirizzi = new();
    private readonly HashSet<long> mappeCaricate = new();
    private bool loading = true;
    private bool isStaff;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            isStaff = state.User.IsInRole(nameof(UserRole.ADMIN)) || state.User.IsInRole(nameof(UserRole.PERSONAL_TRAINER));
            indirizzi = await IndirizziSvc.ElencaAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void CaricaMappa(long id) => mappeCaricate.Add(id);

    /// <summary>
    /// Interpola le coordinate con la cultura invariante: con it-IT il separatore
    /// decimale è la virgola e Google Maps leggerebbe la posizione come 4 numeri.
    /// Se le coordinate mancano si ripiega sull'indirizzo testuale.
    /// </summary>
    private static string Posizione(Indirizzo indirizzo)
    {
        if (indirizzo.Latitudine is double lat && indirizzo.Longitudine is double lng)
        {
            return string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0},{1}", lat, lng);
        }

        var testo = $"{indirizzo.Via} {indirizzo.NumeroCivico}, {indirizzo.Citta} {indirizzo.Provincia}";
        return Uri.EscapeDataString(testo);
    }

    private static string LinkMappa(Indirizzo indirizzo) =>
        $"https://www.google.com/maps?q={Posizione(indirizzo)}&hl=it&z=16&output=embed";

    private static string LinkEsterno(Indirizzo indirizzo) =>
        $"https://www.google.com/maps/search/?api=1&query={Posizione(indirizzo)}";
}
