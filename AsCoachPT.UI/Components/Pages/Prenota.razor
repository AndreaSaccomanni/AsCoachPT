@page "/creaprenotazione"
@inject ServizioService ServiziSvc
@inject IndirizzoService IndirizziSvc
@inject UtenteService UtentiSvc
@inject PrenotazioneService PrenotazioniSvc
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@using System.Globalization

<MudContainer MaxWidth="MaxWidth.Small" Class="my-8">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6">Crea una nuova prenotazione</MudText>

    @if (!autenticato)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            <MudText><strong>Per creare una prenotazione devi accedere o registrarti.</strong></MudText>
        </MudAlert>
        <div class="d-flex gap-2 justify-content-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login">Accedi</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/registrazione">Registrati</MudButton>
        </div>
    }
    else
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/indirizzo" Class="mb-4">
            Indirizzi e Giorni Disponibili
        </MudButton>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Style="white-space: pre-line;">@error</MudAlert>
        }

        @if (giorniRicevimento.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                Nessun giorno di ricevimento è configurato negli studi: contatta lo studio per fissare un appuntamento.
            </MudAlert>
        }
        else if (!tuttiIGiorniDisponibili)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                Il calendario abilita solo i giorni di ricevimento degli studi: <strong>@string.Join(", ", nomiGiorniStudio)</strong>.
                Gli altri giorni non sono selezionabili.
            </MudAlert>
        }

        <MudDatePicker Editable="true"
                       Date="dataSelezionata"
                       DateChanged="OnDataChangedAsync"
                       Label="Seleziona la Data"
                       Color="Color.Primary"
                       Class="mb-4"
                       Required="true"
                       MinDate="dataMinima"
                       FirstDayOfWeek="DayOfWeek.Monday"
                       DateFormat="dd/MM/yyyy"
                       IsDateDisabledFunc="GiornoNonSelezionabile"
                       AdditionalDateClassesFunc="ClasseGiorno" />

        @if (isStaff)
        {
            <MudSelect T="long?" Label="Seleziona un utente" @bind-Value="utenteSelezionato" Class="mb-4">
                @foreach (var utente in utenti)
                {
                    <MudSelectItem T="long?" Value="@utente.Id">@utente.Nome @utente.Cognome</MudSelectItem>
                }
            </MudSelect>
        }

        <MudSelect T="long?" Label="Seleziona un Servizio" Value="servizioSelezionato"
                   ValueChanged="OnServizioChangedAsync" Class="mb-4" Required="true">
            @foreach (var servizio in servizi)
            {
                <MudSelectItem T="long?" Value="@servizio.Id">@servizio.NomeServizio - Durata: @servizio.Durata minuti</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="long?" Label="Seleziona un indirizzo" @bind-Value="indirizzoSelezionato" Class="mb-4" Required="true">
            @foreach (var indirizzo in indirizziFiltrati)
            {
                <MudSelectItem T="long?" Value="@indirizzo.Id">@indirizzo.NomeStudio - @indirizzo.IndirizzoCompleto</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="string" Label="Orari Disponibili" @bind-Value="orarioSelezionato" Class="mb-4" Required="true">
            @foreach (var orario in orari)
            {
                <MudSelectItem T="string" Value="@orario.ToString("HH:mm")">@orario.ToString("HH:mm")</MudSelectItem>
            }
        </MudSelect>

        <MudTextField T="string" Label="Note" @bind-Value="note" Lines="3" Variant="Variant.Outlined" Class="mb-6"
                      Placeholder="Inserisci eventuali note..." />

        <div class="d-flex justify-content-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreaAsync" Disabled="salvando">
                Crea Prenotazione
            </MudButton>
        </div>
    }
</MudContainer>

@code {
    // Giorni in cui almeno uno studio riceve: guidano l'abilitazione del calendario.
    private HashSet<DayOfWeek> giorniRicevimento = new();

    // Nomi italiani dei giorni precedenti, usati nel messaggio informativo.
    private readonly List<string> nomiGiorniStudio = new();

    // Prima data selezionabile: oggi.
    private readonly DateTime dataMinima = DateTime.Today;

    // Catalogo dei servizi prenotabili letto dal database.
    private List<Servizio> servizi = new();

    // Studi attivi, base per il filtro in base al giorno scelto.
    private List<Indirizzo> indirizzi = new();

    // Studi aperti nel giorno scelto, mostrati nella tendina.
    private List<Indirizzo> indirizziFiltrati = new();

    // Utenti selezionabili dallo staff; resta vuoto per gli utenti normali.
    private List<Utente> utenti = new();

    // Orari liberi calcolati per la combinazione data + servizio.
    private List<DateTime> orari = new();

    // Data scelta nel calendario.
    private DateTime? dataSelezionata;

    // Id del servizio scelto.
    private long? servizioSelezionato;

    // Id dello studio scelto.
    private long? indirizzoSelezionato;

    // Id dell'utente per cui prenota lo staff.
    private long? utenteSelezionato;

    // Orario scelto, nel formato HH:mm.
    private string? orarioSelezionato;

    // Note libere allegate alla prenotazione.
    private string? note;

    // Messaggio di errore mostrato sopra il form.
    private string? error;

    // Vero se l'utente autenticato è admin o personal trainer.
    private bool isStaff;

    // Vero se l'utente è autenticato: senza login il form non viene mostrato.
    private bool autenticato;

    // Evita invii doppi mentre la prenotazione viene salvata.
    private bool salvando;

    /// <summary>Vero quando gli studi ricevono tutti i giorni lavorativi.</summary>
    private bool tuttiIGiorniDisponibili =>
        giorniRicevimento.Count >= GiorniStudio.Settimana.Length;

    /// <summary>Carica utente, catalogo servizi, studi e giorni di ricevimento.</summary>
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        autenticato = state.User.Identity?.IsAuthenticated == true;
        if (!autenticato)
        {
            return;
        }

        isStaff = state.User.IsInRole(nameof(UserRole.ADMIN)) || state.User.IsInRole(nameof(UserRole.PERSONAL_TRAINER));

        servizi = await ServiziSvc.ElencaAsync();
        indirizzi = await IndirizziSvc.ElencaAsync();
        CalcolaGiorniRicevimento();

        if (isStaff)
        {
            utenti = await UtentiSvc.ElencaAsync();
        }
    }

    /// <summary>
    /// Ricava i giorni in cui almeno uno studio riceve: sono gli unici
    /// selezionabili nel calendario di prenotazione.
    /// </summary>
    private void CalcolaGiorniRicevimento()
    {
        giorniRicevimento = GiorniStudio.DaStudi(indirizzi);
        nomiGiorniStudio.Clear();

        foreach (var giorno in giorniRicevimento.OrderBy(g => (int)g))
        {
            nomiGiorniStudio.Add(GiorniStudio.NomeItaliano(giorno));
        }
    }

    /// <summary>Giorni passati o senza ricevimento non sono selezionabili.</summary>
    private bool GiornoNonSelezionabile(DateTime data)
    {
        if (data.Date < dataMinima.Date)
        {
            return true;
        }

        return giorniRicevimento.Count == 0 || !giorniRicevimento.Contains(data.DayOfWeek);
    }

    /// <summary>Classe usata dal calendario per evidenziare i giorni di ricevimento.</summary>
    private string ClasseGiorno(DateTime data) =>
        GiornoNonSelezionabile(data) ? string.Empty : "giorno-ricevimento";

    /// <summary>Aggiorna gli studi compatibili e ricalcola gli orari quando cambia la data.</summary>
    private async Task OnDataChangedAsync(DateTime? value)
    {
        dataSelezionata = value;
        FiltraIndirizzi();
        await CaricaOrariAsync();
    }

    /// <summary>Ricalcola gli orari quando cambia il servizio, perché cambia la durata.</summary>
    private async Task OnServizioChangedAsync(long? value)
    {
        servizioSelezionato = value;
        await CaricaOrariAsync();
    }

    /// <summary>
    /// Chiede al servizio di prenotazione gli orari liberi per data e servizio.
    /// Un errore viene mostrato in pagina senza interrompere la compilazione.
    /// </summary>
    private async Task CaricaOrariAsync()
    {
        orari = new List<DateTime>();
        orarioSelezionato = null;

        if (dataSelezionata is not null && servizioSelezionato is > 0)
        {
            try
            {
                error = null;
                orari = await PrenotazioniSvc.CalcolaOrariDisponibiliAsync(
                    DateOnly.FromDateTime(dataSelezionata.Value),
                    servizioSelezionato.Value);
            }
            catch (Exception ex)
            {
                error = ex.Message;
            }
        }
    }

    /// <summary>Tiene solo gli studi che ricevono nel giorno selezionato.</summary>
    private void FiltraIndirizzi()
    {
        indirizzoSelezionato = null;

        if (dataSelezionata is null)
        {
            indirizziFiltrati = new List<Indirizzo>();
            return;
        }

        indirizziFiltrati = indirizzi
            .Where(i => GiorniStudio.StudioAperto(i, dataSelezionata.Value.DayOfWeek))
            .ToList();
    }

    /// <summary>
    /// Valida i campi obbligatori, ricostruisce data e ora scelte e crea la
    /// prenotazione per l'utente corrente o per quello scelto dallo staff.
    /// </summary>
    private async Task CreaAsync()
    {
        error = null;

        if (dataSelezionata is null || servizioSelezionato is null or 0 ||
            indirizzoSelezionato is null or 0 || string.IsNullOrWhiteSpace(orarioSelezionato))
        {
            error = "Compila tutti i campi obbligatori.";
            return;
        }

        salvando = true;
        try
        {
            if (!TimeOnly.TryParseExact(orarioSelezionato, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var ora))
            {
                error = "Orario non valido";
                return;
            }

            var state = await AuthState.GetAuthenticationStateAsync();
            var actor = ClaimsPrincipalFactory.ToAppUser(state.User) ?? throw new InvalidOperationException("Utente non autenticato");

            await PrenotazioniSvc.CreaAsync(
                isStaff && utenteSelezionato is > 0 ? utenteSelezionato : null,
                servizioSelezionato.Value,
                DateOnly.FromDateTime(dataSelezionata.Value).ToDateTime(ora),
                indirizzoSelezionato.Value,
                note,
                actor);

            Snackbar.Add("Prenotazione confermata ✅", Severity.Success);
            Nav.NavigateTo("/prenotazioni");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            salvando = false;
        }
    }
}
