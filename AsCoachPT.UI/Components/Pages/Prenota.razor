@page "/creaprenotazione"
@attribute [Authorize]
@inject ServizioService ServiziSvc
@inject IndirizzoService IndirizziSvc
@inject UtenteService UtentiSvc
@inject PrenotazioneService PrenotazioniSvc
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@using System.Globalization

<MudContainer MaxWidth="MaxWidth.Small" Class="my-8">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6">Crea una nuova prenotazione</MudText>

    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/indirizzo" Class="mb-4">
        Indirizzi e Giorni Disponibili
    </MudButton>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Style="white-space: pre-line;">@error</MudAlert>
    }

    <MudDatePicker Editable="true" Date="dataSelezionata" DateChanged="OnDataChangedAsync" Label="Seleziona la Data" Color="Color.Primary" Class="mb-4" Required="true" />

    @if (isStaff)
    {
        <MudSelect T="long" Label="Seleziona un utente" @bind-Value="utenteSelezionato" Class="mb-4">
            @foreach (var utente in utenti)
            {
                <MudSelectItem T="long" Value="@utente.Id">@utente.Nome @utente.Cognome</MudSelectItem>
            }
        </MudSelect>
    }

    <MudSelect T="long" Label="Seleziona un Servizio" Value="servizioSelezionato"
               ValueChanged="OnServizioChangedAsync" Class="mb-4" Required="true">
        @foreach (var servizio in servizi)
        {
            <MudSelectItem T="long" Value="@servizio.Id">@servizio.NomeServizio - Durata: @servizio.Durata minuti</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="long" Label="Seleziona un indirizzo" @bind-Value="indirizzoSelezionato" Class="mb-4" Required="true">
        @foreach (var indirizzo in indirizziFiltrati)
        {
            <MudSelectItem T="long" Value="@indirizzo.Id">@indirizzo.NomeStudio - @indirizzo.IndirizzoCompleto</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="string" Label="Orari Disponibili" @bind-Value="orarioSelezionato" Class="mb-4" Required="true">
        @foreach (var orario in orari)
        {
            <MudSelectItem T="string" Value="@orario.ToString("HH:mm")">@orario.ToString("HH:mm")</MudSelectItem>
        }
    </MudSelect>

    <MudTextField T="string" Label="Note" @bind-Value="note" Lines="3" Variant="Variant.Outlined" Class="mb-6"
                  Placeholder="Inserisci eventuali note..." />

    <div class="d-flex justify-content-center">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreaAsync" Disabled="salvando">
            Crea Prenotazione
        </MudButton>
    </div>
</MudContainer>

@code {
    private static readonly string[] GiorniSettimana = { "LUNEDI", "MARTEDI", "MERCOLEDI", "GIOVEDI", "VENERDI", "SABATO" };

    private List<Servizio> servizi = new();
    private List<Indirizzo> indirizzi = new();
    private List<Indirizzo> indirizziFiltrati = new();
    private List<Utente> utenti = new();
    private List<DateTime> orari = new();

    private DateTime? dataSelezionata;
    private long servizioSelezionato;
    private long indirizzoSelezionato;
    private long utenteSelezionato;
    private string? orarioSelezionato;
    private string? note;
    private string? error;
    private bool isStaff;
    private bool salvando;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        isStaff = state.User.IsInRole(nameof(UserRole.ADMIN)) || state.User.IsInRole(nameof(UserRole.PERSONAL_TRAINER));

        servizi = await ServiziSvc.ElencaAsync();
        indirizzi = await IndirizziSvc.ElencaAsync();
        if (isStaff)
        {
            utenti = await UtentiSvc.ElencaAsync();
        }
    }

    private async Task OnDataChangedAsync(DateTime? value)
    {
        dataSelezionata = value;
        FiltraIndirizzi();
        await CaricaOrariAsync();
    }

    private async Task OnServizioChangedAsync(long value)
    {
        servizioSelezionato = value;
        await CaricaOrariAsync();
    }

    private async Task CaricaOrariAsync()
    {
        orari = new List<DateTime>();
        orarioSelezionato = null;

        if (dataSelezionata is not null && servizioSelezionato > 0)
        {
            try
            {
                error = null;
                orari = await PrenotazioniSvc.CalcolaOrariDisponibiliAsync(DateOnly.FromDateTime(dataSelezionata.Value), servizioSelezionato);
            }
            catch (Exception ex)
            {
                error = ex.Message;
            }
        }
    }

    private void FiltraIndirizzi()
    {
        indirizzoSelezionato = 0;
        indirizziFiltrati = new List<Indirizzo>();

        if (dataSelezionata is null)
        {
            return;
        }

        var indice = (int)dataSelezionata.Value.DayOfWeek - 1;
        if (indice < 0 || indice >= GiorniSettimana.Length)
        {
            return;
        }

        indirizziFiltrati = indirizzi.Where(i => i.Giorni.Contains(GiorniSettimana[indice])).ToList();
    }

    private async Task CreaAsync()
    {
        error = null;

        if (dataSelezionata is null || servizioSelezionato == 0 || indirizzoSelezionato == 0 || string.IsNullOrWhiteSpace(orarioSelezionato))
        {
            error = "Compila tutti i campi obbligatori.";
            return;
        }

        salvando = true;
        try
        {
            if (!TimeOnly.TryParseExact(orarioSelezionato, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var ora))
            {
                error = "Orario non valido";
                return;
            }

            var state = await AuthState.GetAuthenticationStateAsync();
            var actor = ClaimsPrincipalFactory.ToAppUser(state.User) ?? throw new InvalidOperationException("Utente non autenticato");

            await PrenotazioniSvc.CreaAsync(
                isStaff && utenteSelezionato > 0 ? utenteSelezionato : null,
                servizioSelezionato,
                DateOnly.FromDateTime(dataSelezionata.Value).ToDateTime(ora),
                indirizzoSelezionato,
                note,
                actor);

            Snackbar.Add("Prenotazione confermata ✅", Severity.Success);
            Nav.NavigateTo("/prenotazioni");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            salvando = false;
        }
    }
}
