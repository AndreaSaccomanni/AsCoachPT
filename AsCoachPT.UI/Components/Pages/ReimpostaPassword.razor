@page "/reimposta-password"
@attribute [AllowAnonymous]
@inject PasswordResetService ResetSvc

<div class="container mt-5">
    <div class="row justify-content-md-center">
        <div class="col-md-6 auth-panel">
            <h2 class="text-center">Reimposta password</h2>

            @if (fatto)
            {
                <div class="alert alert-success">
                    Password aggiornata. Ora puoi effettuare il login con la nuova password.
                </div>
                <a href="/login" class="btn btn-primary w-100 mt-3">Vai al login</a>
            }
            else
            {
                <p class="text-muted">Scegli una nuova password di almeno 8 caratteri.</p>

                @if (!string.IsNullOrWhiteSpace(errore))
                {
                    <div class="alert alert-danger">@errore</div>
                }

                <MudTextField T="string" Label="Nuova password" @bind-Value="password" InputType="InputType.Password"
                              Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField T="string" Label="Conferma nuova password" @bind-Value="conferma" InputType="InputType.Password"
                              Variant="Variant.Outlined" Class="mb-3" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvaAsync"
                           Disabled="@(salvando || string.IsNullOrWhiteSpace(password))" Class="w-100">
                    @(salvando ? "Salvataggio..." : "Imposta nuova password")
                </MudButton>

                <div class="text-center mt-3">
                    <a href="/password-dimenticata" class="footer-link">Richiedi un nuovo link</a>
                    <span class="mx-2 text-muted">·</span>
                    <a href="/login" class="footer-link">Torna al login</a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string password = string.Empty;
    private string conferma = string.Empty;
    private string? errore;
    private bool salvando;
    private bool fatto;

    private async Task SalvaAsync()
    {
        if (salvando)
        {
            return;
        }

        errore = null;

        if (string.IsNullOrWhiteSpace(Token))
        {
            errore = "Link non valido. Richiedi una nuova reimpostazione.";
            return;
        }

        if (password != conferma)
        {
            errore = "Le due password non coincidono.";
            return;
        }

        if (password.Length < PasswordResetService.LunghezzaMinimaPassword)
        {
            errore = $"La password deve contenere almeno {PasswordResetService.LunghezzaMinimaPassword} caratteri.";
            return;
        }

        salvando = true;

        try
        {
            if (await ResetSvc.ReimpostaAsync(Token, password))
            {
                fatto = true;
            }
            else
            {
                errore = "Link non valido o scaduto. Richiedi una nuova reimpostazione.";
            }
        }
        catch (Exception)
        {
            errore = "Non è stato possibile aggiornare la password. Riprova più tardi.";
        }
        finally
        {
            salvando = false;
        }
    }
}
