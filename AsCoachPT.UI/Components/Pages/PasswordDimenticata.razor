@page "/password-dimenticata"
@attribute [AllowAnonymous]
@inject PasswordResetService ResetSvc
@inject NavigationManager Nav

<div class="container mt-5">
    <div class="row justify-content-md-center">
        <div class="col-md-6 auth-panel">
            <h2 class="text-center">Password dimenticata</h2>

            @if (inviato)
            {
                <div class="alert alert-success">
                    Se l'indirizzo è registrato, riceverai un'email con il link per reimpostare la password.
                    Il link scade dopo 30 minuti.
                </div>
                <a href="/login" class="btn btn-primary w-100 mt-3">Torna al login</a>
            }
            else
            {
                <p class="text-muted">Inserisci l'email del tuo account.</p>

                @if (!string.IsNullOrWhiteSpace(errore))
                {
                    <div class="alert alert-danger">@errore</div>
                }

                <MudTextField T="string" Label="Email" @bind-Value="email" InputType="InputType.Email"
                              Variant="Variant.Outlined" Class="mb-3" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="InviaAsync"
                           Disabled="@(invio || string.IsNullOrWhiteSpace(email))" Class="w-100">
                    @(invio ? "Invio in corso..." : "Invia link")
                </MudButton>

                <div class="text-center mt-3">
                    <a href="/login" class="footer-link">Torna al login</a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private bool invio;
    private bool inviato;
    private string? errore;

    private async Task InviaAsync()
    {
        if (string.IsNullOrWhiteSpace(email) || invio)
        {
            return;
        }

        invio = true;
        errore = null;

        try
        {
            await ResetSvc.GeneraEInviaAsync(email.Trim(), Nav.BaseUri.TrimEnd('/'));
            inviato = true;
        }
        catch (Exception)
        {
            errore = "Non è stato possibile inviare l'email. Riprova più tardi.";
        }
        finally
        {
            invio = false;
        }
    }
}
