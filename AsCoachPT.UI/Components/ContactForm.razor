@inject ContattiService Contatti
@inject ISnackbar Snackbar

<MudPaper Elevation="0" Class="form-card">
    <MudGrid Spacing="4">
        <MudItem xs="12" sm="6">
            <MudTextField T="string" Label="Nome" @bind-Value="form.Nome" Variant="Variant.Outlined" Required="true" RequiredError="Campo obbligatorio" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField T="string" Label="Cognome" @bind-Value="form.Cognome" Variant="Variant.Outlined" Required="true" RequiredError="Campo obbligatorio" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField T="string" Label="Email" @bind-Value="form.Email" InputType="InputType.Email" Variant="Variant.Outlined" Required="true" RequiredError="Campo obbligatorio" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField T="string" Label="Messaggio" @bind-Value="form.Messaggio" Lines="5" Variant="Variant.Outlined" Required="true" RequiredError="Campo obbligatorio" />
        </MudItem>
    </MudGrid>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="InviaAsync" Disabled="inviando" Class="mt-4 w-100 btn-contatti">
        Invia richiesta
    </MudButton>

    <p class="form-note">I campi contrassegnati con * sono obbligatori.</p>

    @if (campiNonValidi)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-4">Compila tutti i campi con un indirizzo email valido.</MudAlert>
    }
    @if (inviato)
    {
        <MudAlert Severity="Severity.Success" Class="mt-4">Messaggio inviato con successo!</MudAlert>
    }
    @if (errore)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">Errore nell'invio dell'email.</MudAlert>
    }
</MudPaper>

@code {
    private readonly FormInformazioni form = new();
    private bool inviato;
    private bool errore;
    private bool campiNonValidi;
    private bool inviando;

    /// <summary>
    /// Valida i campi, invia la richiesta al servizio applicativo e mostra l'esito.
    /// Il form viene svuotato solo dopo un invio riuscito, così l'utente non perde i dati
    /// in caso di errore di rete o provider email.
    /// </summary>
    private async Task InviaAsync()
    {
        inviato = false;
        errore = false;
        campiNonValidi = false;

        if (string.IsNullOrWhiteSpace(form.Nome) ||
            string.IsNullOrWhiteSpace(form.Cognome) ||
            string.IsNullOrWhiteSpace(form.Messaggio) ||
            !System.Net.Mail.MailAddress.TryCreate(form.Email, out _))
        {
            campiNonValidi = true;
            return;
        }

        inviando = true;

        try
        {
            var esito = await Contatti.InviaRichiestaAsync(form);
            if (esito)
            {
                inviato = true;
                form.Nome = string.Empty;
                form.Cognome = string.Empty;
                form.Email = string.Empty;
                form.Messaggio = string.Empty;
                Snackbar.Add("Messaggio inviato correttamente", Severity.Success);
            }
            else
            {
                errore = true;
            }
        }
        finally
        {
            inviando = false;
        }
    }
}
