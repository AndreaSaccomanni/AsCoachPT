@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<header class="hero-section">
    <div class="hero-copy">
        <AuthorizeView>
            <Authorized Context="auth">
                <p class="hero-eyebrow">Bentornato</p>
                <h2 class="hero-greeting">@(auth.User.FindFirst("nome")?.Value ?? auth.User.Identity?.Name)</h2>
            </Authorized>
        </AuthorizeView>

        <p class="hero-eyebrow">Personal Trainer · Chinesiologo Sportivo</p>
        <h1 class="hero-title">Migliora il tuo<br /><em>benessere</em>!</h1>
        <p class="hero-lead">Scopri un percorso personalizzato per migliorare la tua forma fisica con consulenze personalizzate e massaggi mirati.</p>

        <div class="hero-actions">
            <button type="button" class="btn btn-primary btn-lg" @onclick="Scorri">Scopri i servizi</button>
            <a class="btn btn-ghost btn-lg" href="/creaprenotazione">Prenota una consulenza</a>
        </div>

        <span class="hero-scroll" aria-hidden="true">
            <i class="fas fa-arrow-down"></i>
        </span>
    </div>

    <div class="hero-visual">
        <img class="hero-media"
             src="assets/images/sfondoHome-1920.webp"
             srcset="assets/images/sfondoHome-1280.webp 1280w, assets/images/sfondoHome-1920.webp 1920w"
             sizes="(max-width: 991.98px) 100vw, 50vw"
             alt=""
             aria-hidden="true"
             fetchpriority="high"
             decoding="async" />
    </div>
</header>

@code {
    /// <summary>Scorre alla sezione successiva della home (servizi) senza usare eval.</summary>
    private Task Scorri() => JS.InvokeVoidAsync("asCoachScrollTo", "next-section").AsTask();
}
