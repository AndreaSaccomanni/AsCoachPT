@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<header class="hero-section d-flex justify-content-center align-items-center text-center">
    <div class="hero-content text-white">
        <AuthorizeView>
            <Authorized Context="auth">
                <p class="hero-eyebrow">Bentornato</p>
                <h2 class="hero-greeting display-3 fw-bold nome-utente font-Arvo">@(auth.User.FindFirst("nome")?.Value ?? auth.User.Identity?.Name)</h2>
            </Authorized>
        </AuthorizeView>

        <p class="hero-eyebrow">Personal Trainer · Chinesiologo Sportivo</p>
        <h1 class="hero-title">Migliora il tuo <span class="hero-accent">benessere</span>!</h1>
        <p class="hero-lead">Scopri un percorso personalizzato per migliorare la tua forma fisica con consulenze personalizzate e massaggi mirati.</p>

        <div class="hero-actions">
            <button type="button" class="btn btn-warning btn-lg" @onclick="Scorri">Scopri i servizi</button>
            <a class="btn btn-outline-hero btn-lg" href="/creaprenotazione">Prenota una consulenza</a>
        </div>
    </div>

    <span class="hero-scroll" aria-hidden="true">
        <i class="fas fa-chevron-down"></i>
    </span>
</header>

@code {
    /// <summary>Scorre alla sezione successiva della home (servizi) senza usare eval.</summary>
    private Task Scorri() => JS.InvokeVoidAsync("asCoachScrollTo", "next-section").AsTask();
}
