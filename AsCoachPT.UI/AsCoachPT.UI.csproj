<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AsCoachPT.UI</RootNamespace>
    <AssemblyName>AsCoachPT.UI</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>e5f15d52-2c9b-4e9d-bf82-3ad6fe818d0a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.14" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsCoachPT.Application\AsCoachPT.Application.csproj" />
    <ProjectReference Include="..\AsCoachPT.Infrastructure\AsCoachPT.Infrastructure.csproj" />
  </ItemGroup>

</Project>
