@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<header class="hero-section d-flex justify-content-center align-items-center text-center">
    <div class="hero-content text-white">
        <section class="text-center d-flex flex-column justify-content-center align-items-center">
            <AuthorizeView>
                <Authorized Context="auth">
                    <h2 class="my-4 display-3 fw-bold nome-utente font-Arvo">Bentornato @(auth.User.FindFirst("nome")?.Value ?? auth.User.Identity?.Name)</h2>
                </Authorized>
            </AuthorizeView>
            <h1 class="display-4 fw-bold mt-4">Migliora il tuo benessere!</h1>
            <p class="lead">Scopri un percorso personalizzato per migliorare la tua forma fisica con consulenze personalizzate e massaggi mirati.</p>
        </section>
        <button class="btn btn-warning btn-md mt-3" @onclick="Scorri">Scopri di più</button>
    </div>
</header>

@code {
    private Task Scorri() => JS.InvokeVoidAsync("eval", "document.getElementById('next-section')?.scrollIntoView({behavior:'smooth'})").AsTask();
}
