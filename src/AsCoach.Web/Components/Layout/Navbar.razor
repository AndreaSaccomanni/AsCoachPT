@inject NavigationManager NavigationManager

<nav class="navbar navbar-expand-md navbar-gradient py-3 px-3 @(IsHome ? "navbar-transparent text-light" : "navbar-dark")">
    <div class="container-fluid">
        <a href="/" class="navbar-brand fw-bold fs-4 d-flex align-items-center navbar-brand-responsive" style="color: white;">
            <img src="logo.webp" alt="Logo AS" class="me-2" style="width: 43px; height: 43px; object-fit: contain; filter: drop-shadow(0px 0px 5px rgba(255, 140, 0, 0.5));" />
            Alessandro Saccomanni - PT
        </a>

        <button class="navbar-toggler d-md-none p-0" type="button" aria-label="Apri menu" @onclick="ToggleMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse @(menuOpen ? "show" : string.Empty)">
            <ul class="navbar-nav me-auto text-center">
                <li class="nav-item"><a class="nav-link px-3" href="/" @onclick="CloseMenu">Home</a></li>
                <li class="nav-item"><a class="nav-link px-3" href="/indirizzo" @onclick="CloseMenu">Indirizzi</a></li>
                <li class="nav-item"><a class="nav-link px-3" href="/creaprenotazione" @onclick="CloseMenu">Prenota</a></li>
            </ul>

            <AuthorizeView>
                <Authorized Context="auth">
                    <ul class="navbar-nav text-center">
                        <li class="nav-item"><a class="nav-link px-3" href="/prenotazioni" @onclick="CloseMenu">Prenotazioni</a></li>
                        @if (auth.User.IsInRole(nameof(UserRole.ADMIN)) || auth.User.IsInRole(nameof(UserRole.PERSONAL_TRAINER)))
                        {
                            <li class="nav-item"><a class="nav-link px-3" href="/utenti" @onclick="CloseMenu">Utenti</a></li>
                        }
                    </ul>
                    <form method="post" action="/auth/logout" class="d-flex">
                        <button type="submit" class="nav-link px-3 text-danger border-0 bg-transparent">Logout</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <ul class="navbar-nav text-center">
                        <li class="nav-item"><a class="nav-link px-3" href="/login" @onclick="CloseMenu">Login</a></li>
                        <li class="nav-item"><a class="nav-link px-3" href="/registrazione" @onclick="CloseMenu">Registrati</a></li>
                    </ul>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

@code {
    private bool menuOpen;

    private bool IsHome => new Uri(NavigationManager.Uri).AbsolutePath is "/" or "";

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void CloseMenu() => menuOpen = false;
}
